{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.player.guns_hold": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        "plasma_rifle_controller",
                        {
                            "guns_bullet_counter_controller": "q.equipped_item_all_tags('slot.weapon.mainhand', 'is_gun')"
                        },
                        "guns_swap_controller",
                        "guns_sneak_controller"
                    ]
                }
            }
        },
        "controller.animation.player.guns_bullet_counter": {
            "initial_state": "inactive",
            "states": {
                "inactive": {
                    "transitions": [
                        {
                            "display": "1"
                        }
                    ]
                },
                "display": {
                    "on_entry": [
                        "/function guns/bullet_counter/display"
                    ],
                    "transitions": [
                        {
                            "inactive": "1"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.guns_swap": {
            "initial_state": "inactive",
            "states": {
                "inactive": {
                    "transitions": [
                        {
                            "plasma_rifle": "q.is_item_name_any('slot.weapon.mainhand', 'sc:plasma_rifle')"
                        }
                    ]
                },
                "plasma_rifle": {
                    "on_entry": [
                        "/playsound effect.gun.draw @a[r=5] ~~~ 1 1 0.01"
                    ],
                    "transitions": [
                        {
                            "inactive": "!q.is_item_name_any('slot.weapon.mainhand', 'sc:plasma_rifle')"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.guns_sneak": {
            "initial_state": "inactive",
            "states": {
                "inactive": {
                    "transitions": [
                        {
                            "plasma_rifle": "q.is_item_name_any('slot.weapon.mainhand', 'sc:plasma_rifle') && q.is_sneaking"
                        }
                    ]
                },
                "plasma_rifle": {
                    "transitions": [
                        {
                            "inactive": "!q.is_item_name_any('slot.weapon.mainhand', 'sc:plasma_rifle') || !q.is_sneaking"
                        }
                    ]
                }
            }
        }
    }
}