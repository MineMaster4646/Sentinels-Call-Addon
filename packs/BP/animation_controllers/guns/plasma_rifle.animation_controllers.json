{
    "format_version": "1.21.0",
    "animation_controllers": {
        "controller.animation.player.plasma_rifle": {
            "initial_state": "inactive",
            "states": {
                "inactive": {
                    "transitions": [
                        {
                            "fire": "q.is_item_name_any('slot.weapon.mainhand', 0, 'sc:plasma_rifle') && q.main_hand_item_use_duration && q.scoreboard('plasma_rifle') >= 1 && q.is_alive"
                        }
                    ]
                },
                "fire": {
                    "animations": [
                        "plasma_rifle_fire"
                    ],
                    "on_entry": [
                        "/function guns/fire/plasma_rifle"
                    ],
                    "transitions": [
                        {
                            "inactive": "q.all_animations_finished || !q.is_alive"
                        }
                    ]
                }
            }
        }
    }
}