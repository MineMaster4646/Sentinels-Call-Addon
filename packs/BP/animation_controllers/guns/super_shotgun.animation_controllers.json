{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.player.super_shotgun": {
            "initial_state": "inactive",
            "states": {
                "inactive": {
                    "transitions": [
                        {
                            "fire": "q.is_item_name_any('slot.weapon.mainhand', 'sc:super_shotgun') && q.main_hand_item_use_duration && q.scoreboard('super_shotgun') >= 2 && q.is_alive"
                        }
                    ]
                },
                "fire": {
                    "animations": [
                        "super_shotgun_fire"
                    ],
                    "on_entry": [
                        "/function guns/fire/super_shotgun"
                    ],
                    "transitions": [
                        {
                            "inactive": "q.all_animations_finished || !q.is_alive"
                        }
                    ]
                }
            }
        }
    }
}