{
    "format_version": "1.21.90",
    "minecraft:entity": {
        "description": {
            "identifier": "sc:fireborne_baron",
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "property:fb_animation": {
                    "client_sync": true,
                    "default": 0,
                    "range": [
                        0,
                        10
                    ],
                    "type": "int"
                }
            }
        },
        "component_groups": {
            "leap_start": {
                "minecraft:behavior.leap_at_target": {
                    "must_be_on_ground": true,
                    "set_persistent": true,
                    "yd": 3,
                    "target_dist": 0
                }
            },
            "leap_land": {
                "minecraft:timer": {
                    "time": 0,
                    "looping": true,
                    "time_down_event": {
                        "event": "fireborne_baron:leap_land",
                        "target": "self"
                    }
                }
            }
        },
        "components": {
            "minecraft:attack": {
                "damage": 10
            },
            "minecraft:breathable": {},
            "minecraft:behavior.hurt_by_target": {
                "alert_same_type": true,
                "priority": 3
            },
            "minecraft:behavior.random_stroll": {
                "xz_dist": 10,
                "y_dist": 7,
                "priority": 8
            },
            "minecraft:collision_box": {
                "height": 3.5,
                "width": 1
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "on_damage": {
                            "filters": {
                                "test": "has_damage",
                                "subject": "self",
                                "value": "fall"
                            }
                        },
                        "deals_damage": "no"
                    }
                ]
            },
            "minecraft:environment_sensor": {
                "triggers": [
                    {
                        "event": "fireborne_baron:leap_start",
                        "target": "self",
                        "filters": [
                            {
                                "test": "distance_to_nearest_player",
                                "operator": ">=",
                                "value": 3
                            },
                            {
                                "test": "distance_to_nearest_player",
                                "operator": "<=",
                                "value": 5
                            }
                        ]
                    }
                ]
            },
            "minecraft:health": {
                "value": 700
            },
            "minecraft:jump.dynamic": {},
            "minecraft:movement": {
                "value": 0.2
            },
            "minecraft:movement.basic": {},
            "minecraft:navigation.generic": {},
            "minecraft:on_target_acquired": {},
            "minecraft:physics": {},
            "minecraft:pushable": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "remove": {
                    "component_groups": [
                        "leap_start",
                        "leap_land"
                    ]
                }
            },
            "fireborne_baron:leap_start": {
                "add": {
                    "component_groups": [
                        "leap_start"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "leap_land"
                    ]
                }
            },
            "fireborne_baron:leap_land": {
                "queue_command": {
                    "command": "execute at @s run damage @e[r=3, type=!sc:fireborne_baron] 8 entity_attack entity @e[type=sc:fireborne_baron]"
                },
                "remove": {
                    "component_groups": [
                        "leap_start"
                    ]
                }
            },
            "fireborne_baron:leap_finish": {
                "remove": {
                    "component_groups": [
                        "leap_start",
                        "leap_land"
                    ]
                }
            }
        }
    }
}