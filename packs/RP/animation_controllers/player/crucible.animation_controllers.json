{
    "format_version": "1.21.0",
    "animation_controllers": {
        "controller.animation.player.crucible_root": {
            "initial_state": "first_person",
            "states": {
                "first_person": {
                    "transitions": [
                        {
                            "paperdoll": "v.paperdoll"
                        },
                        {
                            "third_person": "!v.is_first_person"
                        }
                    ]
                },
                "paperdoll": {
                    "animations": [
                        "humanoid_base_pose",
                        "look_at_target_ui",
                        "move.legs",
                        "cape"
                    ],
                    "transitions": [
                        {
                            "first_person": "!v.paperdoll&&v.is_first_person"
                        },
                        {
                            "third_person": "!v.paperdoll&&!v.is_first_person"
                        }
                    ]
                },
                "third_person": {
                    "animations": [
                        "humanoid_base_pose",
                        "move.legs",
                        "cape",
                        {
                            "riding.legs": "q.is_riding"
                        },
                        {
                            "damage_nearby_mobs": "v.damage_nearby_mobs"
                        },
                        {
                            "swimming": "v.swim_amount"
                        },
                        {
                            "swimming.legs": "v.swim_amount"
                        },
                        {
                            "crawling": "q.is_crawling"
                        },
                        {
                            "crawling.legs": "q.is_crawling"
                        },
                        {
                            "sleeping": "q.is_sleeping&&q.is_alive"
                        },
                        {
                            "shield_block_off_hand": "q.blocking&&q.is_item_name_any('slot.weapon.offhand', 'minecraft:shield')"
                        }
                    ],
                    "transitions": [
                        {
                            "paperdoll": "v.paperdoll"
                        },
                        {
                            "first_person": "v.is_first_person"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.crucible_hold": {
            "initial_state": "first_person",
            "states": {
                "first_person": {
                    "animations": [
                        "crucible_controller"
                    ],
                    "transitions": [
                        {
                            "third_person": "!v.is_first_person"
                        }
                    ]
                },
                "third_person": {
                    "animations": [
                        {
                            "crucible_item": "v.crucible"
                        },
                        {
                            "crucible_tpp_controller": "v.crucible"
                        }
                    ],
                    "transitions": [
                        {
                            "first_person": "v.is_first_person"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.crucible_tpp": {
            "initial_state": "inactive",
            "states": {
                "inactive": {
                    "transitions": [
                        {
                            "hold": "v.crucible && !q.is_sleeping && !q.is_emoting && !v.swim_amount && !q.is_crawling"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "hold": {
                    "animations": [
                        "crucible_tpp_hold"
                    ],
                    "transitions": [
                        {
                            "inactive": "!v.crucible||q.is_sleeping||q.is_emoting||v.swim_amount||q.is_crawling"
                        }
                    ],
                    "blend_transition": 0.2
                }
            }
        }
    }
}